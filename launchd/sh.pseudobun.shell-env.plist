<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- GUI apps (T3 Code, Ghostty, editors) read SHELL from launchd, which says /bin/zsh;
     this makes it fish for everything started after login. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>sh.pseudobun.shell-env</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/launchctl</string>
        <string>setenv</string>
        <string>SHELL</string>
        <string>/opt/homebrew/bin/fish</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
