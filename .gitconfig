[user]
	name = Urban Vidovič
	email = urbanfoundit@gmail.com
	signingkey = 3C6FB610DBED15600E8FAEB4389F01C7E97E0262
[commit]
	gpgSign = true
[credential]
	helper = osxkeychain
# GitHub over HTTPS through the gh login (the vault repo and agents push this way)
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[gpg]
	program = /opt/homebrew/bin/gpg
[gitbutler]
	gitbutlerCommitter = 0
