<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Secondary AdGuard Home (replica of minsky 192.168.1.161). DNS :53, web UI :3312.
  User LaunchAgent: olympus auto-logs in as pseudobun, and macOS lets a user bind
  ports below 1024 on 0.0.0.0 only (bind_hosts must stay 0.0.0.0), so no root is needed.
  AdGuard's first-launch root check is skipped because the repo seeds AdGuardHome.yaml. Installed by `just dns-install`.
  Log: ~/Library/Logs/adguardhome.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cloud.bunnys.adguardhome</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/pseudobun/opt/adguardhome/AdGuardHome</string>
    <string>--work-dir</string>
    <string>/Users/pseudobun/opt/adguardhome/data</string>
    <string>--config</string>
    <string>/Users/pseudobun/opt/adguardhome/data/AdGuardHome.yaml</string>
    <string>--no-check-update</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/Users/pseudobun/Library/Logs/adguardhome.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/pseudobun/Library/Logs/adguardhome.log</string>
</dict>
</plist>
