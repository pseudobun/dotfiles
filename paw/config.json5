// paw configuration (JSON5: comments and trailing commas are fine).
// Saved changes apply immediately. Delete a key to use its default.
// The settings window (paw settings, or the menu bar icon) writes this file too.
{
  layout: {
    // New workspaces: "bsp", "columns", "master", "stack" or "float"
    default: "stack",
    gap: 10,
    padding: { top: 2, bottom: 2, left: 24, right: 24 },
    // Extra room for a status bar such as sketchybar (41 for a 40 pt bar); menu bar and Dock are already left out
    barTop: 41,
    barBottom: 0,
    // Workspaces 1…N exist from the start; "workspace new" adds more
    workspaces: 7,
    // Where initiate and setup switches put windows of apps no preset or rule places:
// a workspace ("4"), or "" to leave them on the workspace they're on
    unassignedWorkspace: "",
    // bsp: tiles never get smaller than this; when more windows don't fit, the tree grows past
    // the screen and the screen follows focus (like TrellisWM's canvas). 0: off, tiles shrink
    // freely and only windows whose app refuses the size get a placeholder
    minTileWidth: 0,
    minTileHeight: 0,
    // A window whose app won't shrink to its tile waits out of sight and a placeholder with its
    // icon takes the tile; false: the window keeps its size and sticks out over its neighbours
    placeholders: true,
    // resizing stops before a tile, and so a placeholder, gets smaller than this
    placeholderMinWidth: 160,
    placeholderMinHeight: 120,
  },

  focus: {
    mouseFollowsFocus: true,
    focusFollowsMouse: false,
    // stack.next on the last window goes back to the first (false: it stays)
    wrapStacks: false,
  },

  animation: {
    enabled: true,
    durationMs: 180,
    // linear, easeOutCubic, easeInOutCubic, easeOutQuint, easeOutBack, spring
    curve: "easeOutCubic",
    // "start": final size first, then glide (smooth); "animate": size every frame; "end"
    resize: "start",
    // More windows moving at once than this are placed without animation
    maxWindows: 12,
  },

  // Presets: which apps go in which tile. initiate, arrange (or opening the app) puts them there.
  // Used when no setup below matches the connected displays.
  workspaces: {
    "1": { layout: "stack", tiles: [ { apps: ["Brave Browser"] } ] },
    "2": { layout: "stack", tiles: [ { apps: ["T3 Code (Beta)"] } ] },
    "3": { layout: "stack", tiles: [ { apps: ["Discord", "Spotify"] } ] },
    "5": { layout: "stack", tiles: [ { apps: ["Signal"] } ] },
    "6": { layout: "stack", tiles: [ { apps: ["Mail", "KeePassXC"] } ] },
    "7": { layout: "stack", tiles: [ { apps: ["Finder"] } ] },
  },

  // Presets per display arrangement. When the connected displays match a setup's `displays`
  // (one entry each: "builtin", "external" or part of a name), its workspaces replace the ones
  // above, every display shows its pinned workspace and windows move where the presets say.
  setups: {
    home: {
      displays: ["builtin", "DELL", "Gigabyte"],
      focus: "9",
      workspaces: {
        "1": { display: "builtin" },
        "2": { display: "builtin" },
        "3": { display: "builtin" },
        "4": { display: "builtin" },
        "5": { display: "builtin", layout: "stack", tiles: [ { apps: ["Signal"] } ] },
        "6": { display: "builtin", layout: "stack", tiles: [ { apps: ["Mail", "KeePassXC"] } ] },
        "7": { display: "builtin", layout: "stack", tiles: [ { apps: ["Finder"] } ] },
        "8": { display: "DELL", layout: "stack", tiles: [ { apps: ["Discord", "Spotify"] } ] },
        "9": { display: "Gigabyte", layout: "bsp", tiles: [ { apps: ["Brave Browser"], size: 2 }, { apps: ["T3 Code (Beta)"], size: 1 } ] },
      },
    },
    laptop: {
      displays: ["builtin"],
      focus: "2",
      workspaces: {
        "1": { layout: "stack", tiles: [ { apps: ["Brave Browser"] } ] },
        "2": { layout: "stack", tiles: [ { apps: ["T3 Code (Beta)"] } ] },
        "3": { layout: "stack", tiles: [ { apps: ["Discord", "Spotify"] } ] },
        "5": { layout: "stack", tiles: [ { apps: ["Signal"] } ] },
        "6": { layout: "stack", tiles: [ { apps: ["Mail", "KeePassXC"] } ] },
        "7": { layout: "stack", tiles: [ { apps: ["Finder"] } ] },
      },
    },
    work: {
      displays: ["builtin", "DELL", "PHL"],
      focus: "9",
      workspaces: {
        "1": { display: "builtin" },
        "2": { display: "builtin" },
        "3": { display: "builtin" },
        "4": { display: "builtin" },
        "5": { display: "builtin", layout: "stack", tiles: [ { apps: ["Signal"] } ] },
        "6": { display: "builtin", layout: "stack", tiles: [ { apps: ["Mail", "KeePassXC"] } ] },
        "7": { display: "builtin", layout: "stack", tiles: [ { apps: ["Finder"] } ] },
        "8": { display: "DELL", layout: "stack", tiles: [ { apps: ["Discord", "Spotify"] } ] },
        "9": { display: "PHL", layout: "bsp", tiles: [ { apps: ["Brave Browser"], size: 2 }, { apps: ["T3 Code (Beta)"], size: 1 } ] },
      },
    },
  },

  // app: name or /regex/; title / unlessTitle: substring or /regex/
  // manage: false leaves windows alone, float: true floats them, workspace: where they open
  rules: [
    { app: "/^(He3|System Settings|Parallels Desktop|Raycast|Perplexity)$/", float: true },
    { app: "/^(CleanShot X|Screen Studio|Shottr|Loom|OBS|Kap|Xnapper)$/", manage: false },
    { app: "Brave Browser", unlessTitle: "Brave", float: true },
    { app: "/^Digital Colou?r Meter$/", float: true },
  ],

  // Stack indicators: an island next to each stack with one app icon per window
  indicator: {
    // the islands beside stacks, one icon per window
    enabled: true,
    // "auto" (outside, on the side nearer the screen edge), "left", "right", "insideLeft", "insideRight"
    side: "auto",
    offsetX: 6,
    offsetY: 2,
    width: 28,
    cellHeight: 22,
    gap: 2,
    padding: 3,
    titles: "hover", // or "never"
    clickToFocus: true,
    scrollToCycle: true,
    unfocusedOpacity: 0.6,
    fadeMs: 150,
  },

  appearance: {
    font: "GeistMono Nerd Font",
    fontSize: 12,
    appFont: "sketchybar-app-font",
    appIconSize: 14,
    radius: 9,
    cellRadius: 7,
    borderWidth: 1,
    shadow: true,
    // 0xAARRGGBB or "#RRGGBB"
    colors: {
      island: "0xeb1d1d16",
      islandHi: "0xff2b2b22",
      border: "0x1affffff",
      fg: "0xfffbfbf9",
      muted: "0xffabab9c",
      dim: "0xff5f5f52",
      accent: "0xffead186",
      wave: "0xff8698eb",
      good: "0xff43d58f",
      bad: "0xffff6467",
    },
  },

  icons: {
    // sketchybar's app → glyph map; paw's built-in copy is used when it's missing
    map: "~/.config/sketchybar/helpers/app_icons.lua",
    overrides: {},
    // Each icon in the app's own colour (picked from its app icon); colors fixes single apps
    brandColors: true,
    colors: {},
  },

  // Shell commands with $PAW_WORKSPACE / $PAW_PREV_WORKSPACE, $PAW_APP / $PAW_WINDOW;
  // windowsChanged runs when windows open, close or change workspace (read `paw query --json`);
  // modeChanged when a mode turns on or off ($PAW_MODE, "" for off);
  // displaysChanged after displays come, go or move and paw has retiled ($PAW_DISPLAYS)
  hooks: {
    workspaceChanged: "",
    windowFocused: "",
    windowsChanged: "",
    modeChanged: "",
    displaysChanged: "~/.config/sketchybar/plugins/displays_changed.sh",
  },

  mouse: {
    // Drop a dragged tile on a tile's edge to split it there, on the gap between tiles to make
    // room there, at the screen's edge to dock beside everything, in a tile's middle to swap
    // (holding stackModifier: to stack). A preview shows where it lands.
    dropZones: true,
    stackModifier: "alt", // alt, cmd, ctrl or shift
    // Drag the gap between two tiles to resize both; double-click it to even them out
    seamHandles: true,
    // Hold a mouse button (middle, back, forward), drag left/right/up/down (or "click"), release
    gestures: [
      { button: "middle", direction: "left", command: "workspace prev" },
      { button: "middle", direction: "right", command: "workspace next" },
      { button: "middle", direction: "up", command: "overview" },
    ],
    // No gestures while one of these is in front (they pan or orbit with the middle button)
    gestureIgnoreApps: ["/CAD/", "/Fusion/", "/Slicer$/", "/Bambu ?Studio/", "Blender", "FreeCAD", "SketchUp", "Shapr3D", "/KiCad/", "Figma", "Affinity Designer", "/Unity|Unreal/", "Godot", "Minecraft"],
    // Hold it and scroll or pinch over a window to zoom through the tree towards it ("off": never)
    zoomModifier: "alt",
  },

  // overview (hyper+tab): every workspace and its windows. Arrows move, Return goes there,
  // typing filters, drag a window onto a workspace or next to another window, Esc closes.
  overview: {
    // Window pictures: "auto" (if Screen Recording is already allowed), "on" (asks), "off" (icons)
    thumbnails: "auto",
  },

  // The island that flashes the workspace's number and apps when you switch
  hud: {
    workspace: true,
    durationMs: 600,
  },

  // A line around the focused window (or a placeholder that has focus)
  border: {
    enabled: false,
    color: "0xccead186", // 0xAARRGGBB or "#RRGGBB"
    width: 2,
    radius: 12,
    offset: 2,
  },

  // `paw initiate` (also `paw reset`): opens the apps, waits for their windows, then arranges
  // every preset. apps: [] means every plain app name in the presets.
  initiate: {
    apps: [],
    focus: "2",
    timeout: 15,
  },

  openAtLogin: true,

  // New versions from GitHub releases. Homebrew installs can also `brew upgrade --cask pseudobun/tap/paw`.
  updates: {
    check: true, // look once a day and offer to install
    automatic: true, // install without asking; paw relaunches
  },

  // Keys: cmd ctrl alt shift fn hyper meh, lalt/ralt (and lcmd, rctrl…), a key name or 0x keycode.
  // Commands (also `paw <command>`; chain with ";"):
  //   focus west|east|north|south|stack.next|stack.prev   swap|warp|stack <dir>   swap stack.next|stack.prev   unstack [all]
  //   layout bsp|columns|master|stack|float   toggle float|zoom|split   balance   rotate 90|180|270
  //   undo   redo   focus back|forward   find <app or title>   overview   zoom in|out
  //   resize <dir> <points>   grid rows:cols:x:y:w:h   workspace <n>|next|prev|last|new|close
  //   move-to <n>|next|prev [--follow]   display <dir>|next|n   move-to-display <dir> [--follow]
  //   arrange [workspace|all]   initiate   mode <name>|exit   retile   recover   reload   exec <shell command>
  // Setting bindings replaces this whole list.
  bindings: {
    "hyper+o": "focus back",
    "ctrl+right": "focus east",
    "hyper+i": "focus forward",
    "ctrl+up": "focus north",
    "ctrl+down": "focus south",
    "hyper+right": "focus stack.next",
    "hyper+left": "focus stack.prev",
    "ctrl+left": "focus west",
    "ctrl+alt+right": "swap east",
    "ctrl+alt+up": "swap north",
    "ctrl+alt+down": "swap south",
    "hyper+down": "swap stack.next",
    "hyper+up": "swap stack.prev",
    "ctrl+alt+left": "swap west",
    "ctrl+shift+right": "stack east",
    "ctrl+shift+up": "stack north",
    "ctrl+shift+down": "stack south",
    "ctrl+shift+left": "stack west",
    "cmd+shift+ctrl+right": "warp east",
    "cmd+shift+ctrl+up": "warp north",
    "cmd+shift+ctrl+down": "warp south",
    "cmd+shift+ctrl+left": "warp west",
    "cmd+alt+ctrl+right": "join east",
    "cmd+alt+ctrl+up": "join north",
    "cmd+alt+ctrl+down": "join south",
    "cmd+alt+ctrl+left": "join west",
    "ctrl+alt+u": "unstack",
    "hyper+w": "layout bsp",
    "hyper+f": "layout float",
    "hyper+s": "layout stack",
    "ctrl+alt+space": "toggle float",
    "ctrl+alt+c": "toggle float; grid 4:4:1:1:2:2",
    "ctrl+alt+s": "toggle split",
    "ctrl+alt+return": "toggle zoom",
    "ctrl+shift+return": "grid 1:1:0:0:1:1",
    "hyper+e": "balance",
    "alt+r": "rotate 270",
    "shift+ctrl+d": "resize east -40",
    "shift+alt+d": "resize east 40",
    "shift+ctrl+w": "resize north -40",
    "shift+alt+w": "resize north 40",
    "shift+ctrl+s": "resize south -40",
    "shift+alt+s": "resize south 40",
    "shift+ctrl+a": "resize west -40",
    "shift+alt+a": "resize west 40",
    "hyper+d": "workspace close",
    "hyper+n": "workspace new",
    "ralt+d": "workspace next",
    "ralt+a": "workspace prev",
    "ctrl+0": "workspace side",
    "ralt+0": "workspace side",
    "ctrl+1": "workspace 1",
    "ralt+1": "workspace 1",
    "ctrl+2": "workspace 2",
    "ralt+2": "workspace 2",
    "ctrl+3": "workspace 3",
    "ralt+3": "workspace 3",
    "ctrl+4": "workspace 4",
    "ralt+4": "workspace 4",
    "ctrl+5": "workspace 5",
    "ralt+5": "workspace 5",
    "ctrl+6": "workspace 6",
    "ralt+6": "workspace 6",
    "ctrl+7": "workspace 7",
    "ralt+7": "workspace 7",
    "ctrl+8": "workspace 8",
    "ralt+8": "workspace 8",
    "ctrl+9": "workspace 9",
    "ralt+9": "workspace 9",
    "cmd+ctrl+0": "move-to side --follow",
    "cmd+ralt+0": "move-to side --follow",
    "ralt+shift+0": "move-to side",
    "cmd+ctrl+1": "move-to 1 --follow",
    "cmd+ralt+1": "move-to 1 --follow",
    "ralt+shift+1": "move-to 1",
    "cmd+ctrl+2": "move-to 2 --follow",
    "cmd+ralt+2": "move-to 2 --follow",
    "ralt+shift+2": "move-to 2",
    "cmd+ctrl+3": "move-to 3 --follow",
    "cmd+ralt+3": "move-to 3 --follow",
    "ralt+shift+3": "move-to 3",
    "cmd+ctrl+4": "move-to 4 --follow",
    "cmd+ralt+4": "move-to 4 --follow",
    "ralt+shift+4": "move-to 4",
    "cmd+ctrl+5": "move-to 5 --follow",
    "cmd+ralt+5": "move-to 5 --follow",
    "ralt+shift+5": "move-to 5",
    "cmd+ctrl+6": "move-to 6 --follow",
    "cmd+ralt+6": "move-to 6 --follow",
    "ralt+shift+6": "move-to 6",
    "cmd+ctrl+7": "move-to 7 --follow",
    "cmd+ralt+7": "move-to 7 --follow",
    "ralt+shift+7": "move-to 7",
    "cmd+ctrl+8": "move-to 8 --follow",
    "cmd+ralt+8": "move-to 8 --follow",
    "ralt+shift+8": "move-to 8",
    "cmd+ctrl+9": "move-to 9 --follow",
    "cmd+ralt+9": "move-to 9 --follow",
    "ralt+shift+9": "move-to 9",
    "hyper+r": "mode resize",
    "hyper+z": "undo",
    "hyper+y": "redo",
    "hyper+tab": "overview",
    "cmd+alt+r": "recover",
    "hyper+0x18": "exec open -a Alacritty",
    "hyper+đ": "move-workspace next",
    "hyper+š": "move-workspace prev",
    "hyper+j": "zoom in",
    "hyper+k": "zoom out",
  },

  // While a mode is on (`mode resize`, hyper+r), its keys come before the bindings above and an
  // island at the top of the screen says so. resize <dir> <points> moves that edge.
  modes: {
    resize: {
      "e": "balance",
      "shift+l": "resize east -40",
      "shift+right": "resize east -40",
      "l": "resize east 40",
      "right": "resize east 40",
      "shift+k": "resize north -40",
      "shift+up": "resize north -40",
      "k": "resize north 40",
      "up": "resize north 40",
      "shift+down": "resize south -40",
      "shift+j": "resize south -40",
      "down": "resize south 40",
      "j": "resize south 40",
      "shift+h": "resize west -40",
      "shift+left": "resize west -40",
      "h": "resize west 40",
      "left": "resize west 40",
      "escape": "mode exit",
      "hyper+r": "mode exit",
      "return": "mode exit",
    },
  },
}
