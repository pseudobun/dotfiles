#!/opt/homebrew/bin/lua
-- SbarLua config. Module: ~/.local/share/sketchybar_lua/sketchybar.so
-- (build: git clone https://github.com/FelixKratz/SbarLua && make install)
local home = os.getenv("HOME")
local dir = os.getenv("CONFIG_DIR") or (home .. "/.config/sketchybar")
package.cpath = package.cpath .. ";" .. home .. "/.local/share/sketchybar_lua/?.so"
package.path = dir .. "/?.lua;" .. dir .. "/helpers/?.lua;" .. package.path

sbar = require("sketchybar")
sbar.begin_config()
require("init")
-- hotload off: reloads raced the cpu helper and left duplicate config processes.
-- Apply changes with: brew services restart sketchybar
sbar.hotload(false)
sbar.end_config()
sbar.event_loop()
